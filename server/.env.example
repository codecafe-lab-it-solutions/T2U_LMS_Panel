# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/t2u_lms"

# JWT secret key — use a long random string in production
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Server port
PORT=4000

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# AES-256 key for encrypting Zoom client_secret at rest (32 random bytes, hex-encoded = 64 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZOOM_ENCRYPTION_KEY="change-me-64-hex-chars"

# Absolute path for uploaded files — set to a directory OUTSIDE the git tree on production
# so uploads survive deploys (e.g. /var/www/t2u-uploads)
UPLOAD_DIR="./uploads"
