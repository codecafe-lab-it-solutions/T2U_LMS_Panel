// ── Income Sources — admin-configurable income/reward types ──────────────────
model IncomeSource {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String   @unique @db.VarChar(50)
  name             String   @db.VarChar(100)
  description      String?  @db.VarChar(500)
  category         String   @db.VarChar(50) // dsi | generational | binary | milestone | course | referral
  rate             Decimal? @db.Decimal(8, 4) // percentage (10.0000 = 10%)
  fixed_amount     Decimal? @db.Decimal(12, 2) // fixed ₹ amount (overrides rate when set)
  daily_cap        Decimal? @db.Decimal(12, 2) // daily cap ₹ (for binary)
  generation_level Int? // hops from buyer (2=gen2, 3=gen3, 4=gen4 …)
  min_bv_per_side  Decimal? @db.Decimal(12, 2) // minimum BV required on each binary leg (milestone/fund)
  min_months       Int? // consecutive months to qualify (milestone/fund)
  cap_amount       Decimal? @db.Decimal(12, 2) // maximum payout per cap period (milestone/fund)
  cap_period_value Int? // number of units in the cap period (e.g. 1, 3)
  cap_period_unit  String?  @db.VarChar(10) // 'day' | 'month'
  is_active        Boolean  @default(true)
  is_system        Boolean  @default(false) // system sources cannot be deleted
  order_index      Int      @default(0)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("income_sources")
}

// ── HRMS / Employee Management — fully separate identity from User/Role ──────
// Employees are NOT a User.role value; they have their own login, own table, and
// only ever get access to admin pages via an admin-defined, dynamic role/permission
// grant (see EmployeeRole/EmployeeRolePermission below). Deliberately decoupled from
// User so this can never collide with student/instructor/admin auth or data.
model Employee {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_code       String    @unique @db.VarChar(20)
  full_name           String    @db.VarChar(255)
  email               String    @unique @db.VarChar(255)
  phone               String?   @db.VarChar(15)
  password_hash       String
  designation         String?   @db.VarChar(100)
  department          String?   @db.VarChar(100)
  date_of_joining     DateTime? @db.Date
  profile_photo_url   String?
  is_active           Boolean   @default(true)
  reset_token_hash    String?   @db.VarChar(64)
  reset_token_expires DateTime?
  last_login_at       DateTime?
  created_by          String?   @db.Uuid
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  role_assignments EmployeeRoleAssignment[]
  salary_structure EmployeeSalaryStructure?
  payslips         EmployeePayslip[]
  incentives       EmployeeIncentive[]

  @@map("employees")
}

// Dynamic, admin-defined role — no hardcoded role names in code. Admin types in
// whatever name they want ("CRM", "Payment Approval", "KYC Verification", ...).
model EmployeeRole {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  permissions EmployeeRolePermission[]
  assignments EmployeeRoleAssignment[]

  @@map("employee_roles")
}

// One row per (role, page) — page_key matches an admin-* ActiveTab value on the
// frontend. Five independent operation flags per page, per the confirmed CRUD+Approve
// model (Approve kept distinct from Edit for withdrawal/KYC/order-approval workflows).
model EmployeeRolePermission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id     String  @db.Uuid
  page_key    String  @db.VarChar(60)
  can_view    Boolean @default(false)
  can_create  Boolean @default(false)
  can_edit    Boolean @default(false)
  can_delete  Boolean @default(false)
  can_approve Boolean @default(false)

  role EmployeeRole @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, page_key])
  @@map("employee_role_permissions")
}

// Join table — one employee can hold multiple roles; effective permission for a page+
// operation is the logical OR across every role an employee is actively assigned.
model EmployeeRoleAssignment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id String   @db.Uuid
  role_id     String   @db.Uuid
  assigned_at DateTime @default(now())
  assigned_by String?  @db.Uuid

  employee Employee     @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  role     EmployeeRole @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, role_id])
  @@map("employee_role_assignments")
}

// One active salary structure per employee — basis for manually-created monthly payslips.
model EmployeeSalaryStructure {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id      String   @unique @db.Uuid
  basic            Decimal  @db.Decimal(10, 2)
  hra              Decimal  @default(0) @db.Decimal(10, 2)
  other_allowances Decimal  @default(0) @db.Decimal(10, 2)
  pf_percent       Decimal  @default(0) @db.Decimal(5, 2)
  effective_from   DateTime @db.Date
  updated_at       DateTime @updatedAt
  updated_by       String?  @db.Uuid

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@map("employee_salary_structures")
}

enum PayslipStatus {
  draft
  finalized
  paid
}

// Manual monthly payroll ledger entry — admin creates/edits while draft, then finalizes
// and marks paid. Totals are always server-computed, never trusted from the client.
model EmployeePayslip {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id      String        @db.Uuid
  month            Int           @db.SmallInt
  year             Int           @db.SmallInt
  basic            Decimal       @db.Decimal(10, 2)
  hra              Decimal       @default(0) @db.Decimal(10, 2)
  other_allowances Decimal       @default(0) @db.Decimal(10, 2)
  gross_earnings   Decimal       @db.Decimal(10, 2)
  pf_deduction     Decimal       @default(0) @db.Decimal(10, 2)
  other_deductions Decimal       @default(0) @db.Decimal(10, 2)
  total_deductions Decimal       @db.Decimal(10, 2)
  net_pay          Decimal       @db.Decimal(10, 2)
  status           PayslipStatus @default(draft)
  remarks          String?
  finalized_at     DateTime?
  paid_at          DateTime?
  created_by       String?       @db.Uuid
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, month, year])
  @@map("employee_payslips")
}

// Ad-hoc bonus/incentive entries, independent of the monthly payslip cycle.
model EmployeeIncentive {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id String   @db.Uuid
  title       String   @db.VarChar(255)
  amount      Decimal  @db.Decimal(10, 2)
  reason      String?
  awarded_on  DateTime @db.Date
  created_by  String?  @db.Uuid
  created_at  DateTime @default(now())

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@map("employee_incentives")
}
